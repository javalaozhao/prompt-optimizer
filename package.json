{
  "name": "promptmaster-pro",
  "version": "1.3.0",
  "private": true,
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": "^18.0.0 || ^20.0.0 || ^22.0.0",
    "npm": "请使用pnpm代替npm",
    "yarn": "请使用pnpm代替yarn"
  },
  "scripts": {
    "build": "npm-run-all build:core build:ui build:web",
    "build:core": "pnpm -F @prompt-optimizer/core build",
    "build:ui": "pnpm -F @prompt-optimizer/ui build",
    "build:web": "pnpm -F @prompt-optimizer/web build",
    "dev": "npm-run-all clean:dist build:core build:ui dev:parallel",
    "dev:fresh": "npm-run-all clean pnpm-install dev",
    "dev:parallel": "concurrently -k -p \"[{name}]\" -n \"UI,WEB\" \"pnpm -F @prompt-optimizer/ui build --watch\" \"pnpm -F @prompt-optimizer/web dev\"",
    "test": "pnpm -r test --run --passWithNoTests",
    "test:react": "vitest run components/LanguageSwitcher.test.tsx",
    "clean": "npm-run-all clean:dist clean:vite",
    "clean:dist": "rimraf packages/core/dist packages/ui/dist packages/web/dist",
    "clean:vite": "rimraf packages/core/node_modules/.vite packages/ui/node_modules/.vite packages/web/node_modules/.vite",
    "pnpm-install": "pnpm install",
    "version:sync": "node scripts/sync-versions.js",
    "version": "pnpm run version:sync && git add -A",
    "version:prepare": "pnpm version --no-git-tag-version",
    "version:tag": "git tag v$(node -p \"require('./package.json').version\")",
    "version:publish": "git push origin v$(node -p \"require('./package.json').version\")"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^6.0.3",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^1.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "i18next": "^24.2.2",
    "i18next-browser-languagedetector": "^8.0.4",
    "jsdom": "^24.1.1",
    "lodash-unified": "^1.0.3",
    "lucide-react": "^0.417.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^4.4.1",
    "tailwind-merge": "^2.4.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.2",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@floating-ui/core": "^1.6.9",
    "@floating-ui/dom": "^1.6.13",
    "@floating-ui/utils": "^0.2.9",
    "@popperjs/core": "^2.11.8",
    "@vue/reactivity": "^3.5.13",
    "@vue/runtime-core": "^3.5.13",
    "@vue/runtime-dom": "^3.5.13",
    "@vue/shared": "^3.5.13",
    "@vueuse/core": "^12.7.0",
    "@vueuse/shared": "^12.7.0",
    "async-validator": "^4.2.5",
    "dayjs": "^1.11.13",
    "lodash-es": "^4.17.21",
    "memoize-one": "^6.0.0",
    "next-intl": "^4.3.4",
    "normalize-wheel-es": "^1.2.0",
    "vue-i18n": "^10.0.6"
  },
  "keywords": [
    "prompt",
    "optimizer",
    "ai",
    "llm",
    "web-service"
  ],
  "author": "",
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "builder-util-runtime": "9.2.10"
    }
  }
}